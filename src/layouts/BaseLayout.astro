---
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/Footer.astro';
import { CustomCursor } from '@/components/CustomCursor';
import { LenisSmoothScroll } from '@/components/LenisSmoothScroll';
import { SiteHeader } from '@/components/SiteHeader';
import { ProgressiveBlur } from '@/components/ui/progressive-blur';
import Analytics from '@/components/Analytics.astro';
import { CONTACT_SOCIALS } from '@/lib/contact-info';
import { REDUCE_VIEWPORT_EFFECTS_INLINE } from '@/lib/device-capabilities';
import {
	DEFAULT_OG_IMAGE,
	OG_IMAGE_HEIGHT,
	OG_IMAGE_WIDTH,
	SITE_LOCALE,
	SITE_NAME,
	SITE_URL,
	TWITTER_HANDLE,
} from '@/lib/seo';

interface Props {
	title?: string;
	description?: string;
	isFooterInverse?: boolean;
	noindex?: boolean;
	ogImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = 'Dhanwanth Parameswar',
	description = `Hey! I'm a Computer Engineering student with a passion for building innovative software. On this personal website, you can discover my work, learn more about me, and get in touch with me.`,
	isFooterInverse = false,
	noindex = false,
	ogImage = DEFAULT_OG_IMAGE,
	ogImageWidth = OG_IMAGE_WIDTH,
	ogImageHeight = OG_IMAGE_HEIGHT,
	ogImageAlt,
	structuredData,
} = Astro.props;

/** Framer marketplace progressive blur ~50px max; Magic UI default curve scaled to cap at 50 */
const viewportTopBlurLevels = [0.4, 0.8, 1.5, 3, 6, 12.5, 25, 50];

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);
const ogImageURL = new URL(ogImage, Astro.site || SITE_URL);
const jsonLdBlocks = structuredData
	? Array.isArray(structuredData)
		? structuredData
		: [structuredData]
	: [];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link id="site-favicon-svg" rel="icon" type="image/svg+xml" href="/favicon-light.svg" />
		<link id="site-favicon-ico" rel="icon" href="/favicon-light.ico" sizes="any" />
		<link rel="preload" href="/logo-light.svg" as="image" type="image/svg+xml" />
		<link rel="preload" href="/logo-dark.svg" as="image" type="image/svg+xml" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalURL} />
		{noindex ? <meta name="robots" content="noindex, follow" /> : null}
		{description ? <meta name="description" content={description} /> : null}
		<title>{title}</title>

		<link rel="me" href={CONTACT_SOCIALS.find((s) => s.label === 'GitHub')?.href} />
		<link rel="me" href={CONTACT_SOCIALS.find((s) => s.label === 'LinkedIn')?.href} />

		<!-- OpenGraph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content={SITE_LOCALE} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		{ogImageAlt ? <meta property="og:image:alt" content={ogImageAlt} /> : null}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={TWITTER_HANDLE} />
		<meta name="twitter:creator" content={TWITTER_HANDLE} />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		{
			jsonLdBlocks.map((block) => (
				<script type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}

		<ClientRouter />
		<script is:inline>
			const getSiteTheme = () => {
				const stored = localStorage.getItem('theme');
				if (stored === 'dark' || stored === 'light') return stored;
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};

			const applyFavicon = (theme) => {
				const variant = theme === 'dark' ? 'dark' : 'light';
				const svg = document.getElementById('site-favicon-svg');
				const ico = document.getElementById('site-favicon-ico');
				const base = `/favicon-${variant}`;
				if (svg) svg.setAttribute('href', `${base}.svg`);
				if (ico) ico.setAttribute('href', `${base}.ico`);
			};

			const applyTheme = () => {
				const theme = getSiteTheme();
				document.documentElement.classList.toggle('dark', theme === 'dark');
				applyFavicon(theme);
			};

			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				if (!localStorage.getItem('theme')) applyTheme();
			});

			new MutationObserver(() => {
				applyFavicon(document.documentElement.classList.contains('dark') ? 'dark' : 'light');
			}).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
		</script>
		<script is:inline set:html={REDUCE_VIEWPORT_EFFECTS_INLINE} />
		<Analytics />
	</head>
	<body>
		<div class="skip-links">
			<a class="skip-link" href="#main-content">Skip to main content</a>
			<a class="skip-link" href="#site-nav-first">Skip to navigation</a>
		</div>
		<div class="site-grain" aria-hidden="true" transition:persist></div>
		<CustomCursor client:media="(pointer: fine)" transition:persist />
		<LenisSmoothScroll client:load transition:persist />
		<div class="viewport-chrome" transition:persist>
			<ProgressiveBlur
				position="top"
				height="60px"
				blurLevels={viewportTopBlurLevels}
				className="fixed inset-x-0 top-0 z-40"
			/>
			<div
				class="viewport-bottom-fade pointer-events-none fixed inset-x-0 bottom-0 z-40 h-[60px]"
				aria-hidden="true"
			/>
		</div>
		<SiteHeader client:visible transition:persist />
		<div class="pt-[var(--site-header-clearance)]">
			<main id="main-content" tabindex="-1">
				<slot />
			</main>
		</div>
		<Footer isInverse={isFooterInverse} />

		<script>
			/**
			 * High-performance scroll reveal observer.
			 * Watches for .reveal-item elements and sets data-visible="true" when they enter the viewport.
			 * This runs once on load and remains lightweight (native Intersection Observer).
			 */
			const observerOptions = {
				root: null,
				rootMargin: '0px 0px -10% 0px',
				threshold: 0.05 // Lower threshold guarantees that tall cards trigger reveal reliably as soon as they enter
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						(entry.target as HTMLElement).dataset.visible = 'true';
						observer.unobserve(entry.target);
					}
				});
			}, observerOptions);

			function setupReveals() {
				document.querySelectorAll('.reveal-item, .prose > *').forEach(el => observer.observe(el));
			}

			function processTaskLists() {
				document.querySelectorAll('.prose li').forEach(li => {
					const trimmed = li.innerHTML.trim();
					if (trimmed.startsWith('[/]')) {
						const parent = li.parentElement;
						if (parent && !parent.classList.contains('contains-task-list')) {
							parent.classList.add('contains-task-list');
						}
						li.classList.add('task-list-item');
						const rawHtml = li.innerHTML;
						const prefixIndex = rawHtml.indexOf('[/]');
						const contentWithoutPrefix = rawHtml.substring(prefixIndex + 3).trim();
						li.innerHTML = `<input type="checkbox" disabled data-progress="in-progress" /> ${contentWithoutPrefix}`;
					}
				});
			}

			// Viewport Bottom Fade Opacity controller based on Work Pagination position
			function updateFadeOpacity() {
				if (document.documentElement.classList.contains('reduce-viewport-effects')) return;

				const fadeEl = document.querySelector('.viewport-bottom-fade') as HTMLElement;
				const paginationEl = document.getElementById('work-pagination');
				if (!fadeEl) return;
				if (!paginationEl) {
					fadeEl.style.opacity = '1';
					return;
				}
				const rect = paginationEl.getBoundingClientRect();
				const viewportHeight = window.innerHeight;
				
				if (rect.top >= viewportHeight) {
					fadeEl.style.opacity = '1';
				} else if (rect.bottom <= viewportHeight) {
					fadeEl.style.opacity = '0';
				} else {
					const height = rect.bottom - rect.top;
					if (height > 0) {
						const progress = (viewportHeight - rect.top) / height;
						fadeEl.style.opacity = Math.max(0, Math.min(1, 1 - progress)).toString();
					}
				}
			}

			const reduceViewportEffects = () =>
				document.documentElement.classList.contains('reduce-viewport-effects');

			// Initialize
			setupReveals();
			processTaskLists();
			if (!reduceViewportEffects()) {
				updateFadeOpacity();
				window.addEventListener('scroll', updateFadeOpacity, { passive: true });
				window.addEventListener('resize', updateFadeOpacity, { passive: true });
			}

			// Handle Astro view transitions if they are added later
			document.addEventListener('astro:after-swap', () => {
				setupReveals();
				processTaskLists();
				if (!reduceViewportEffects()) updateFadeOpacity();
			});
		</script>
	</body>
</html>
