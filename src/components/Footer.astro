---
/**
 * Site footer — Framer "Desktop | Inverse" / "Phone | Inverse" (refactored).
 * Outer band: page black; inner card: elevated surface, subtle border, rounded corners.
 */
interface Props {
	headline?: string;
	isInverse?: boolean;
}

const { 
	headline = 'See you soon!', 
	isInverse = false
} = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={[
	"relative z-50 flex w-full flex-col items-center text-foreground",
	isInverse ? "bg-surface" : "bg-background"
]}>
	<div
		class="box-border flex w-full max-w-[1440px] flex-col items-center gap-2.5 px-[15px] pb-[15px] pt-0 md:px-[30px] md:pb-[30px] lg:px-[40px] lg:pb-[40px]"
	>
		<div
			class:list={[
				"box-border flex w-full flex-col items-start rounded-[17px] border-[0.5px] border-solid border-border-footer px-5 md:rounded-[18px] md:px-[30px]",
				isInverse ? "bg-background" : "bg-surface"
			]}
		>
			<div
				class="flex w-full flex-col items-start gap-2 py-[30px] md:flex-row md:items-center md:justify-between md:gap-x-6 md:gap-y-4"
			>
				<div class="flex min-w-0 flex-col items-start gap-3">
					<p class="text-foreground font-medium tracking-display text-footer-headline-sm md:text-footer-headline-lg">
						{headline}
					</p>
					<p class="font-normal leading-none text-footer-copyright text-muted">
						Built with
						<a
							href="https://astro.build/"
							target="_blank"
							rel="noreferrer"
							class="text-muted underline decoration-transparent underline-offset-[3px] transition-[text-decoration-color,opacity,color] hover:decoration-current hover:opacity-100"
							data-umami-event="Footer Tech Click"
							data-umami-event-tech="Astro"
							>Astro</a
						>,{' '}
						<a
							href="https://tailwindcss.com/"
							target="_blank"
							rel="noreferrer"
							class="text-muted underline decoration-transparent underline-offset-[3px] transition-[text-decoration-color,opacity,color] hover:decoration-current hover:opacity-100"
							data-umami-event="Footer Tech Click"
							data-umami-event-tech="Tailwind CSS"
							>Tailwind CSS</a
						>, and{' '}
						<a
							href="https://www.framer.com/motion/"
							target="_blank"
							rel="noreferrer"
							class="text-muted underline decoration-transparent underline-offset-[3px] transition-[text-decoration-color,opacity,color] hover:decoration-current hover:opacity-100"
							data-umami-event="Footer Tech Click"
							data-umami-event-tech="Framer Motion"
							>Framer Motion</a
						>.
						<a
							href="https://github.com/DhanwanthParameswar/website"
							target="_blank"
							rel="noreferrer"
							aria-label="View Source"
							title="View Source"
							data-cursor-tooltip="View Source"
							data-umami-event="Footer Source Code Click"
							class="text-muted mt-2 block w-fit transition-colors hover:opacity-100 md:ml-1 md:mt-0 md:inline-flex md:items-center md:translate-y-[2px]"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="currentColor"
								class="h-[16px] w-[16px]"
								aria-hidden="true"
							>
								<path
									d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
								/>
							</svg>
						</a>
					</p>
					<p class="font-normal leading-none text-footer-copyright text-muted md:hidden">
						© {year} •{' '}
						<a
							href="/privacy"
							data-umami-event="Footer Privacy Link Click"
							class="text-muted underline decoration-transparent underline-offset-[3px] transition-[text-decoration-color,opacity,color] hover:decoration-current hover:opacity-100"
							>Privacy Policy</a
						>
					</p>
				</div>
				<div class="shrink-0 font-normal leading-none text-footer-copyright text-muted hidden md:flex items-center gap-3">
					<p>© {year}</p>
					<span class="w-[3px] h-[3px] rounded-full bg-muted/40"></span>
					<a
						href="/privacy"
						data-umami-event="Footer Privacy Link Click"
						class="text-muted underline decoration-transparent underline-offset-[3px] transition-[text-decoration-color,opacity,color] hover:decoration-current hover:opacity-100"
						>Privacy Policy</a
					>
				</div>
			</div>
		</div>
	</div>
</footer>
