---
import { cn } from '@/lib/utils';

type ProjectNav = {
	title: string;
	slug: string;
	color1: string;
	color2: string;
};

interface Props {
	prevProject?: ProjectNav;
	nextProject?: ProjectNav;
}

const { prevProject, nextProject } = Astro.props;
---

<section 
	id="work-pagination"
	class="relative w-full px-6 py-24 md:py-32 overflow-hidden"
>
	<div class="mx-auto max-w-6xl">
		<div class={cn(
			"grid gap-8 md:gap-12",
			prevProject && nextProject ? "grid-cols-1 md:grid-cols-2" : "grid-cols-1"
		)}>
			{/* Previous Project (Order + 1) - Older */}
			{prevProject && (
				<a 
					href={`/work/${prevProject.slug}`}
					data-umami-event="Project Pagination Click"
					data-umami-event-direction="previous"
					data-umami-event-project={prevProject.title}
					data-cursor
					data-cursor-tooltip="View"
					class:list={[
						"group relative flex flex-col items-start gap-4 rounded-3xl border border-border-footer p-8 transition-all duration-500 md:p-12 reveal-item",
						"hover:border-transparent",
						prevProject && !nextProject && "md:col-start-1"
					]}
				>
					{/* Hover Gradient Background */}
					<div 
						class="absolute inset-0 -z-10 opacity-0 transition-opacity duration-500 group-hover:opacity-100 rounded-3xl"
						style={{
							background: `linear-gradient(135deg, ${prevProject.color1}22, ${prevProject.color2}22)`
						}}
					/>
					
					<div class="type-overline flex items-center gap-2 text-muted">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="transition-transform duration-300 group-hover:-translate-x-1"
							aria-hidden="true"
						>
							<line x1="19" y1="12" x2="5" y2="12"></line>
							<polyline points="12 19 5 12 12 5"></polyline>
						</svg>
						<span>Previous Project</span>
					</div>
					
					<h3 class="type-pagination-title text-foreground">
						{prevProject.title}
					</h3>

					{/* Animated Underline */}
					<div class="mt-auto h-px w-0 bg-foreground transition-all duration-500 group-hover:w-full" />
				</a>
			)}

			{/* Next Project (Order - 1) - Newer */}
			{nextProject && (
				<a 
					href={`/work/${nextProject.slug}`}
					data-umami-event="Project Pagination Click"
					data-umami-event-direction="next"
					data-umami-event-project={nextProject.title}
					data-cursor
					data-cursor-tooltip="View"
					class:list={[
						"group relative flex flex-col items-end text-right gap-4 rounded-3xl border border-border-footer p-8 transition-all duration-500 md:p-12 reveal-item",
						"hover:border-transparent",
						nextProject && !prevProject && "md:col-start-1"
					]}
					style={{ transitionDelay: prevProject ? '0.1s' : '0s' }}
				>
					{/* Hover Gradient Background */}
					<div 
						class="absolute inset-0 -z-10 opacity-0 transition-opacity duration-500 group-hover:opacity-100 rounded-3xl"
						style={{
							background: `linear-gradient(135deg, ${nextProject.color1}22, ${nextProject.color2}22)`
						}}
					/>

					<div class="type-overline flex items-center gap-2 text-muted">
						<span>Next Project</span>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="transition-transform duration-300 group-hover:translate-x-1"
							aria-hidden="true"
						>
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</div>
					
					<h3 class="type-pagination-title text-foreground">
						{nextProject.title}
					</h3>

					{/* Animated Underline */}
					<div class="mt-auto h-px w-0 bg-foreground transition-all duration-500 group-hover:w-full" />
				</a>
			)}
		</div>
	</div>
</section>

<style>
	/* Smooth handoff: brief (page bg) → footer (elevated surface). Single layer avoids seam lines from stacked pseudo-elements. */
	#work-pagination {
		background: linear-gradient(
			180deg,
			var(--surface-page) 0%,
			var(--surface-elevated) 100%
		);
	}
</style>
