---
import { getCollection, type CollectionEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { WorkProjectHero } from '@/components/WorkProjectHero.tsx';
import { WorkProjectBrief } from '@/components/WorkProjectBrief.tsx';
import { WorkTechnicalHighlights } from '@/components/WorkTechnicalHighlights.tsx';
import WorkPagination from '@/components/WorkPagination.astro';
import { Button } from '@/components/Button.tsx';
import { creativeWorkJsonLd, metaDescription, SITE_NAME } from '@/lib/seo';

export async function getStaticPaths() {
	const allProjects = await getCollection('work');
	const sortedProjects = allProjects.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

	return sortedProjects.map((project, index) => {
		// Next = Order - 1 (Previous in sorted array index)
		const nextProject = index > 0 ? sortedProjects[index - 1] : null;
		// Previous = Order + 1 (Next in sorted array index)
		const prevProject = index < sortedProjects.length - 1 ? sortedProjects[index + 1] : null;

		const getNavData = (p: CollectionEntry<'work'> | null) => {
			if (!p) return undefined;
			return {
				title: p.data.title,
				slug: p.id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, ''),
				color1: p.data.color1,
				color2: p.data.color2,
			};
		};

		return {
			params: { slug: project.id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '') },
			props: { 
				project,
				nextProject: getNavData(nextProject),
				prevProject: getNavData(prevProject),
			},
		};
	});
}

interface Props {
	project: CollectionEntry<'work'>;
	prevProject?: { title: string; slug: string; color1: string; color2: string };
	nextProject?: { title: string; slug: string; color1: string; color2: string };
}

const { project, prevProject, nextProject } = Astro.props;

if (!project) {
	return Astro.redirect('/404');
}

const { title, description, details } = project.data;
const slug = project.id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '');
const pageTitle = `${title} — ${SITE_NAME}`;
const pageDescription = metaDescription(details || description);
const { Content } = await render(project);

/** Same scene assets as homepage work cards (light variant for share previews). */
const CARD_OG_WIDTH = 800;
const optimizedCardOg = await getImage({
	src: project.data.imageLight,
	format: 'webp',
	width: CARD_OG_WIDTH,
	quality: 74,
});
const ogImageWidth = CARD_OG_WIDTH;
const ogImageHeight = Math.round(
	CARD_OG_WIDTH * (project.data.imageLight.height / project.data.imageLight.width),
);

// Server-side WebP image optimization for high-fidelity mockups
const heroWidths = [900, 1400] as const;
const heroSizes = '(max-width: 768px) 94vw, (max-width: 1200px) 88vw, 1100px';

const optimizedHeroLight = project.data.finalObjectLight
	? await Promise.all(
			heroWidths.map((width) =>
				getImage({ src: project.data.finalObjectLight, format: 'webp', width, quality: 72 }),
			),
		)
	: null;
const optimizedHeroDark = project.data.finalObjectDark
	? await Promise.all(
			heroWidths.map((width) =>
				getImage({ src: project.data.finalObjectDark, format: 'webp', width, quality: 72 }),
			),
		)
	: null;

const optimizedProjectData = {
	...project.data,
	finalObjectLight: optimizedHeroLight
		? {
				src: optimizedHeroLight[optimizedHeroLight.length - 1].src,
				srcSet: optimizedHeroLight
					.map((image, index) => `${image.src} ${heroWidths[index]}w`)
					.join(', '),
				sizes: heroSizes,
				width: 1400,
				height: Math.round(
					1400 *
						(project.data.finalObjectLight.height / project.data.finalObjectLight.width),
				),
			}
		: undefined,
	finalObjectDark: optimizedHeroDark
		? {
				src: optimizedHeroDark[optimizedHeroDark.length - 1].src,
				srcSet: optimizedHeroDark
					.map((image, index) => `${image.src} ${heroWidths[index]}w`)
					.join(', '),
				sizes: heroSizes,
				width: 1400,
				height: Math.round(
					1400 *
						(project.data.finalObjectDark.height / project.data.finalObjectDark.width),
				),
			}
		: undefined,
};
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	ogImage={optimizedCardOg.src}
	ogImageWidth={ogImageWidth}
	ogImageHeight={ogImageHeight}
	ogImageAlt={`${title} — ${description}`}
	isFooterInverse={true}
	structuredData={creativeWorkJsonLd({
		title,
		description,
		details,
		year: project.data.year,
		category: project.data.category,
		href: project.data.href,
		slug,
	})}
>
	<WorkProjectHero client:visible project={optimizedProjectData} />
	
	<div class="relative z-10 bg-background">
		<WorkProjectBrief client:visible project={optimizedProjectData} />
