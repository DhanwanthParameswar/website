---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import AboutSection from '@/components/AboutSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import Hero from '@/components/Hero.astro';
import WorkSection from '@/components/WorkSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { metaDescription, personJsonLd, SITE_NAME, websiteJsonLd } from '@/lib/seo';

const HOME_TITLE = `${SITE_NAME} — Computer Engineering Student & Software Developer`;
const HOME_DESCRIPTION = metaDescription(
	'Computer Engineering student at the University at Buffalo (Robotics minor), building full-stack software and shipping projects. Explore my portfolio and get in touch.',
);

const projects = await getCollection('work');
const sortedProjects = await Promise.all(
	projects
		.sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
		.map(async p => {
			const slug = p.id.replace(/\.(md|mdx)$/, '').replace(/\/index$/, '');
			const cardWidths = [480, 800] as const;
			const [optimizedLightVariants, optimizedDarkVariants] = await Promise.all([
				Promise.all(
					cardWidths.map((width) =>
						getImage({ src: p.data.imageLight, format: 'webp', width, quality: 72 }),
					),
				),
				Promise.all(
					cardWidths.map((width) =>
						getImage({ src: p.data.imageDark, format: 'webp', width, quality: 72 }),
					),
				),
			]);
			const cardSizes = '(max-width: 768px) 92vw, (max-width: 1200px) 46vw, 560px';
			
			return {
				...p.data,
				slug,
				imageLight: {
					src: optimizedLightVariants[optimizedLightVariants.length - 1].src,
					srcSet: optimizedLightVariants
						.map((image, index) => `${image.src} ${cardWidths[index]}w`)
						.join(', '),
					sizes: cardSizes,
					width: 800,
					height: Math.round(800 * (p.data.imageLight.height / p.data.imageLight.width)),
				},
				imageDark: {
					src: optimizedDarkVariants[optimizedDarkVariants.length - 1].src,
					srcSet: optimizedDarkVariants
						.map((image, index) => `${image.src} ${cardWidths[index]}w`)
						.join(', '),
					sizes: cardSizes,
					width: 800,
					height: Math.round(800 * (p.data.imageDark.height / p.data.imageDark.width)),
				},
			};
		}),
);
---

<BaseLayout
	title={HOME_TITLE}
	description={HOME_DESCRIPTION}
	structuredData={[personJsonLd(), websiteJsonLd()]}
>
	<Hero />
	<WorkSection projects={sortedProjects} />
	<AboutSection />
	<ContactSection />
</BaseLayout>
